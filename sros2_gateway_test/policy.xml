<?xml version="1.0" encoding="UTF-8"?>
<policy version="0.2.0">
  <enclaves>
    <!-- gateway_real: the ONLY identity with WRITE permission to
         /mission/command, the counterpart of the real mediation_gateway.py. -->
    <enclave path="/gateway_real">
      <profiles>
        <profile ns="/" node="gateway_pub_node">
          <services reply="ALLOW">
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
          <topics publish="ALLOW">
            <topic>mission/command</topic>
            <topic>parameter_events</topic>
            <topic>rosout</topic>
            <topic>ros_discovery_info</topic>
          </topics>
          <topics subscribe="ALLOW">
            <topic>ros_discovery_info</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

    <!-- executor_real: READ-only permission — the counterpart of the real
         mission_executor.py. -->
    <enclave path="/executor_real">
      <profiles>
        <profile ns="/" node="executor_sub_node">
          <services reply="ALLOW">
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
          <topics subscribe="ALLOW">
            <topic>mission/command</topic>
            <topic>ros_discovery_info</topic>
          </topics>
          <topics publish="ALLOW">
            <topic>parameter_events</topic>
            <topic>rosout</topic>
            <topic>ros_discovery_info</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

    <!-- rogue_real: a VALID SROS2 identity (generated from the keystore) BUT
         INTENTIONALLY WITHOUT write permission to mission/command — in the
         real system it represents a compromised/malicious node attempting to
         BYPASS the gateway and write directly to the command channel. -->
    <enclave path="/rogue_real">
      <profiles>
        <profile ns="/" node="rogue_pub_node">
          <services reply="ALLOW">
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
          <topics publish="ALLOW">
            <topic>parameter_events</topic>
            <topic>rosout</topic>
            <topic>ros_discovery_info</topic>
          </topics>
          <topics subscribe="ALLOW">
            <topic>ros_discovery_info</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>
  </enclaves>
</policy>
